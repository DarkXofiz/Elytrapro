  "authors": ["ElytraPro contributors"],
  "license": "MIT",
  "icon": "assets/elytrapro/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.elytrapro.client.ElytraProClient"]
  },
  "mixins": ["elytrapro.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20.1 <1.21",
    "java": ">=17",
    "fabric-api": "*"
  }
}
